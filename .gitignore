# 构建产物
dist/
data/
runtime/
node_modules/
# 便携游戏目录（首次启动默认创建在启动器旁边）
.minecraft/
**/__pycache__/
*.pyc

# 可选的翻译单文件运行时（源码版默认使用 Python）
vendor/mc-i18n/dist/

# WebView2 SDK 缓存（构建时自动拉取）
host/lib/

# 本机临时工具（含绝对路径）
dl-mt.mjs
# 本机文件完整性标签修复脚本（只在当前 Windows 环境使用）
fix-low-integrity.cmd

# 工作区/记忆（私有）
.workbuddy/

# 日志与系统
*.log
.DS_Store
Thumbs.db

# 本地整合包验证及下载缓存
.tmp-*/
.tmp-*
.probe/
